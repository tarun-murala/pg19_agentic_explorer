# Copy to .env and adjust values as needed.
INGESTION_DATABASE_URL=postgresql+psycopg://pg19:pg19pass@localhost:5433/pg19_ingestion
INGESTION_PG19_ROOT=./data/pg19
INGESTION_CHUNK_SIZE=1200
INGESTION_CHUNK_OVERLAP=200
INGESTION_EMBEDDING_MODEL=nomic-embed-text
INGESTION_VECTOR_COLLECTION=pg19_chunks
INGESTION_VECTOR_HOST=localhost
INGESTION_VECTOR_PORT=6333
INGESTION_VECTOR_GRPC_PORT=6334
INGESTION_RAG_TOP_K=5
INGESTION_OLLAMA_BASE_URL=http://localhost:11434
KG_OLLAMA_BASE_URL=http://localhost:11434
KG_LLM_MODEL=codellama:7b
ORCH_OLLAMA_BASE_URL=http://localhost:11434
ORCH_LLM_MODEL=codellama:7b